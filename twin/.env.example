# 复制成 twin/.env 后填真实值：cp twin/.env.example twin/.env
# ⚠️ twin/.env 已在 .gitignore 中，绝不提交、绝不写进前端或报告。

# 必填：DeepSeek 开放平台创建的 API Key（充 20 元按量计费足够跑完整个作业）
LLM_API_KEY=replace-with-your-real-key

# 选填：换模型/厂商时改这里，并同步修改报告与 PROCESS/06-deployment.md
LLM_PROVIDER=DeepSeek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# 选填：生成参数与防护（调优时改动要记进 PROCESS/03-prompt-iterations.md）
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=400
LLM_TIMEOUT_MS=30000
RATE_LIMIT=30

# 选填：0 = 日志里只留问题/回答前 40 字；默认 1 = 保留完整问答作为作业证据
LOG_FULL=1

# 选填：本地服务端口
PORT=8787
